{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:JAVA_HOME='C:\\Program Files\\Java\\jdk-23'; Set-Location backend; mvn -q spring-boot:run"
      ],
      "port": 8080
    }
  ]
}
